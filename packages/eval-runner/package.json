{
  "name": "@vibetrace/eval-runner",
  "version": "0.1.0",
  "description": "Isolated, shell-free VibeTrace evaluation execution and success checks.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@vibetrace/eval-spec": "workspace:*",
    "@vibetrace/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
