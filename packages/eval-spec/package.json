{
  "name": "@vibetrace/eval-spec",
  "version": "0.1.0",
  "description": "Versioned, reviewable VibeTrace evaluation manifests.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@vibetrace/schema": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vibetrace/test-fixtures": "workspace:*"
  }
}
