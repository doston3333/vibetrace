{
  "name": "@vibetrace/storage",
  "version": "0.1.0",
  "private": true,
  "description": "Encrypted local SQLite metadata and blob storage for VibeTrace.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@vibetrace/schema": "workspace:*",
    "better-sqlite3-multiple-ciphers": "12.11.1",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3"
  }
}
