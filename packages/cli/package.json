{
  "name": "@vibetrace/cli",
  "version": "0.1.0",
  "description": "Local-first forensic debugger for observable Codex sessions.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "vibetrace": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "better-sqlite3-multiple-ciphers": "12.11.1"
  },
  "devDependencies": {
    "@vibetrace/adapter-codex": "workspace:*",
    "@vibetrace/bundle": "workspace:*",
    "@vibetrace/daemon": "workspace:*",
    "commander": "15.0.0",
    "esbuild": "0.28.1",
    "vite": "8.2.0"
  }
}
