{
  "name": "@vibetrace/cli",
  "version": "0.1.0",
  "description": "Local-first forensic debugger for observable Codex sessions.",
  "license": "Apache-2.0",
  "repository": "git+https://github.com/doston3333/vibetrace.git",
  "homepage": "https://github.com/doston3333/vibetrace#readme",
  "bugs": {
    "url": "https://github.com/doston3333/vibetrace/issues"
  },
  "keywords": [
    "ai-coding",
    "codex",
    "debugger",
    "evaluation",
    "forensics",
    "local-first"
  ],
  "author": "doston3333",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "vibetrace": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "better-sqlite3-multiple-ciphers": "12.11.1"
  },
  "devDependencies": {
    "@vibetrace/adapter-codex": "workspace:*",
    "@vibetrace/adapter-codex-app-server": "workspace:*",
    "@vibetrace/adapter-claude-code": "workspace:*",
    "@vibetrace/bundle": "workspace:*",
    "@vibetrace/daemon": "workspace:*",
    "@vibetrace/eval-runner": "workspace:*",
    "@vibetrace/eval-compare": "workspace:*",
    "@vibetrace/eval-spec": "workspace:*",
    "@vibetrace/schema": "workspace:*",
    "@vibetrace/adapter-generic-jsonl": "workspace:*",
    "commander": "15.0.0",
    "esbuild": "0.28.1",
    "vite": "8.2.0"
  }
}
