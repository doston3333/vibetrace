{
  "name": "@vibetrace/diagnostics",
  "version": "0.1.0",
  "description": "Deterministic, evidence-linked diagnostic rules for VibeTrace.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./src/fixtures.ts",
      "development": "./src/fixtures.ts",
      "default": "./dist/fixtures.js"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@vibetrace/enrichment": "workspace:*",
    "@vibetrace/schema": "workspace:*",
    "@vibetrace/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vibetrace/test-fixtures": "workspace:*"
  }
}
