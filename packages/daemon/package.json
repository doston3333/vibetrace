{
  "name": "@vibetrace/daemon",
  "version": "0.1.0",
  "description": "Loopback-only local ingest daemon for VibeTrace.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.2",
    "@vibetrace/bundle": "workspace:*",
    "@vibetrace/diagnostics": "workspace:*",
    "@vibetrace/analyzer-ai": "workspace:*",
    "@vibetrace/eval-compare": "workspace:*",
    "@vibetrace/eval-spec": "workspace:*",
    "@vibetrace/adapter-otel": "workspace:*",
    "@vibetrace/schema": "workspace:*",
    "@vibetrace/storage": "workspace:*",
    "fastify": "5.11.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
